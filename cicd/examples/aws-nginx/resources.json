        "TagSpecification.1.ResourceType": "route-table",
        "TagSpecification.1.Tag.1.Key": "Name",
        "TagSpecification.1.Tag.1.Value": {
          "from": "input",
          "attribute": "tag_route_table"
        }
      },
      "desired": {},
      "inbound": [
        {
          "from": "vpc",
          "as": "VpcId"
        }
      ]
    },
    {
      "key": "default_route",
      "provider": "aws",
      "address": "ec2.web_default_route",
      "identity": "id",
      "addressed_by": "RouteTableId",
