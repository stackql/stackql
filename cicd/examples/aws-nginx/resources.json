      "provider": "aws",
      "address": "ec2.web_security_group",
      "identity": "id",
      "addressed_by": "GroupId",
      "write_once": {
        "GroupDescription": "omnisdk nginx demo",
        "GroupName": {
          "from": "input",
          "attribute": "group_name"
        },
        "TagSpecification.1.ResourceType": "security-group",
        "TagSpecification.1.Tag.1.Key": "Name",
        "TagSpecification.1.Tag.1.Value": {
          "from": "input",
          "attribute": "tag_security_group"
        }
      },
      "desired": {},
      "inbound": [
        {
          "from": "vpc",
          "as": "VpcId"
        }
      ]
    },
    {
      "key": "ingress",
      "provider": "aws",
      "address": "ec2.web_ingress",
      "identity": "id",
      "addressed_by": "GroupId",
      "write_once": {
        "IpPermissions.1.FromPort": "22",
        "IpPermissions.1.IpProtocol": "tcp",
        "IpPermissions.1.IpRanges.1.CidrIp": {
          "from": "input",
          "attribute": "ssh_cidr"
        },
        "IpPermissions.1.ToPort": "22",
        "IpPermissions.2.FromPort": "80",
        "IpPermissions.2.IpProtocol": "tcp",
        "IpPermissions.2.IpRanges.1.CidrIp": {
          "from": "input",
          "attribute": "http_cidr"
        },
        "IpPermissions.2.ToPort": "80"
      },
      "desired": {},
      "inbound": [
