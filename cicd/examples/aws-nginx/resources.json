          "from": "route_table",
          "as": "RouteTableId"
        },
        {
          "from": "gateway_attachment",
          "as": "GatewayId"
        }
      ]
    },
    {
      "key": "association_a",
      "provider": "aws",
      "address": "ec2.web_association_a",
