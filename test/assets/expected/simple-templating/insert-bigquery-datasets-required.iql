<<<jsonnet
{
   projectId: << projectId >>,
   data__datasetReference:    {
   datasetId: << datasetId >>,
   projectId: << projectId >>
   }
}
>>>
INSERT INTO google.bigquery.datasets(
  projectId,
  data__datasetReference
)
SELECT
  '{{ .projectId }}',
  '{ "datasetId": "{{ .data__datasetReference.datasetId }}", "projectId": "{{ .data__datasetReference.projectId }}" }'
;
