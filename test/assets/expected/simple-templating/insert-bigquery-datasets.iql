<<<jsonnet
{
   projectId: << projectId >>,
   data__access:    [ {
     dataset: << dataset >>,
     domain: << domain >>,
     groupByEmail: << groupByEmail >>,
     iamMember: << iamMember >>,
     role: << role >>,
     routine: << routine >>,
     specialGroup: << specialGroup >>,
     userByEmail: << userByEmail >>,
     view: << view >>
     } ],
   data__datasetReference:    {
   datasetId: << datasetId >>,
   projectId: << projectId >>
   },
   data__defaultEncryptionConfiguration:    {
   kmsKeyName: << kmsKeyName >>
   },
   data__defaultPartitionExpirationMs:    << data__defaultPartitionExpirationMs >>,
   data__defaultTableExpirationMs:    << data__defaultTableExpirationMs >>,
   data__description:    << data__description >>,
   data__friendlyName:    << data__friendlyName >>,
   data__isCaseInsensitive:    << data__isCaseInsensitive >>,
   data__labels:    << data__labels >>,
   data__location:    << data__location >>
}
>>>
INSERT INTO google.bigquery.datasets(
  projectId,
  data__access,
  data__datasetReference,
  data__defaultEncryptionConfiguration,
  data__defaultPartitionExpirationMs,
  data__defaultTableExpirationMs,
  data__description,
  data__friendlyName,
  data__isCaseInsensitive,
  data__labels,
  data__location
)
SELECT
  '{{ .projectId }}',
  '[ { "dataset": {{ .data__access[0].dataset }}, "domain": "{{ .data__access[0].domain }}", "groupByEmail": "{{ .data__access[0].groupByEmail }}", "iamMember": "{{ .data__access[0].iamMember }}", "role": "{{ .data__access[0].role }}", "routine": {{ .data__access[0].routine }}, "specialGroup": "{{ .data__access[0].specialGroup }}", "userByEmail": "{{ .data__access[0].userByEmail }}", "view": {{ .data__access[0].view }} } ]',
  '{ "datasetId": "{{ .data__datasetReference.datasetId }}", "projectId": "{{ .data__datasetReference.projectId }}" }',
  '{ "kmsKeyName": "{{ .data__defaultEncryptionConfiguration.kmsKeyName }}" }',
  '{{ .data__defaultPartitionExpirationMs }}',
  '{{ .data__defaultTableExpirationMs }}',
  '{{ .data__description }}',
  '{{ .data__friendlyName }}',
   {{ .data__isCaseInsensitive }},
   {{ .data__labels }},
  '{{ .data__location }}'
;
